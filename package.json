  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "PORTLESS_PORT=1355 PORTLESS_HTTPS=0 portless run nest start",
    "start:dev": "PORTLESS_PORT=1355 PORTLESS_HTTPS=0 portless run nest start --watch",
    "start:dev:http": "PORTLESS_PORT=1355 PORTLESS_HTTPS=0 portless run nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun x prisma db push && bun run dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "create:user": "bun run scripts/create-user.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
